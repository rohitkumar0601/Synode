# Local dev settings for the Synthetic Data Trust Lab (copy to .env) when running the API or
# workers on the host against the compose backing services. Inside compose, containers use a
# shared /stl-store volume; host-run processes use the local outputs/store directory.
STL_STORAGE_ROOT=outputs/store
DATABASE_URL=postgresql+psycopg://stl:stl@127.0.0.1:55432/stl
REDIS_URL=redis://127.0.0.1:6379/0
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# API (host port 8010 in compose) and web (3010)
STL_CORS_ORIGINS=http://localhost:3010
STL_MAX_UPLOAD_MB=200
NEXT_PUBLIC_API_URL=http://localhost:8010
# Celery worker: task modules to load (sdv/smartnoise: stl_runner.tasks;
# synthcity: stl_runner.tasks,stl_synthcity.tasks; eval: stl_eval.tasks)
STL_CELERY_INCLUDE=stl_runner.tasks
# Eval worker overrides (defaults: full evaluation); compose's eval worker lowers these for speed
# STL_EVAL_N_ATTACKS=200
# STL_EVAL_MIN_ATTACKS=100
# STL_EVAL_SINGLING_OUT_MODE=univariate
# Data Designer track (S6)
NVIDIA_API_KEY=
