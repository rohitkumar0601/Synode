# Base URL of the FastAPI service (default: http://127.0.0.1:8010)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8010

# Set to 1 to serve the API from in-browser MSW mocks (no backend needed)
NEXT_PUBLIC_API_MOCK=0

# Client-side upload size guard in MB (default: 200).
# Must match the API's STL_MAX_UPLOAD_MB, or the UI will accept files the server rejects (or vice versa).
NEXT_PUBLIC_MAX_UPLOAD_MB=200
